server {
  listen 8080;
  server_tokens off;
  client_max_body_size 64k;

  location = /health {
    default_type application/json;
    return 200 '{"ok":true}';
  }

  location = /v1/whatsapp/messages {
    if ($http_x_agesoma_broker_token != "${CREDENTIAL_BROKER_SERVICE_TOKEN}") { return 403; }
    limit_except POST { deny all; }

    proxy_ssl_server_name on;
    proxy_set_header Host graph.facebook.com;
    proxy_set_header Authorization "Bearer ${WHATSAPP_CLOUD_ACCESS_TOKEN}";
    proxy_set_header Content-Type application/json;
    proxy_pass https://graph.facebook.com/${WHATSAPP_GRAPH_VERSION}/${WHATSAPP_CLOUD_PHONE_NUMBER_ID}/messages;
  }


  # Windsor credentials stay inside the broker. The worker and HERMES never receive
  # the API key. Access logging is disabled on these locations because Windsor's
  # Connectors API currently authenticates with a query parameter.
  location = /v1/paid-media/facebook/data {
    if ($http_x_agesoma_broker_token != "${CREDENTIAL_BROKER_SERVICE_TOKEN}") { return 403; }
    limit_except GET { deny all; }
    access_log off;

    proxy_ssl_server_name on;
    proxy_set_header Host connectors.windsor.ai;
    proxy_pass https://connectors.windsor.ai/facebook?api_key=${WINDSOR_API_KEY}&$args;
  }

  location = /v1/paid-media/google_ads/data {
    if ($http_x_agesoma_broker_token != "${CREDENTIAL_BROKER_SERVICE_TOKEN}") { return 403; }
    limit_except GET { deny all; }
    access_log off;

    proxy_ssl_server_name on;
    proxy_set_header Host connectors.windsor.ai;
    proxy_pass https://connectors.windsor.ai/google_ads?api_key=${WINDSOR_API_KEY}&$args;
  }

  location = /v1/paid-media/all/data {
    if ($http_x_agesoma_broker_token != "${CREDENTIAL_BROKER_SERVICE_TOKEN}") { return 403; }
    limit_except GET { deny all; }
    access_log off;

    proxy_ssl_server_name on;
    proxy_set_header Host connectors.windsor.ai;
    proxy_pass https://connectors.windsor.ai/all?api_key=${WINDSOR_API_KEY}&$args;
  }

  location = /v1/paid-media/facebook/actions {
    if ($http_x_agesoma_broker_token != "${CREDENTIAL_BROKER_SERVICE_TOKEN}") { return 403; }
    limit_except GET POST { deny all; }
    access_log off;

    proxy_ssl_server_name on;
    proxy_set_header Host connectors.windsor.ai;
    proxy_set_header Content-Type application/json;
    proxy_pass https://connectors.windsor.ai/facebook/actions?api_key=${WINDSOR_API_KEY};
  }

  location / {
    return 404;
  }
}
