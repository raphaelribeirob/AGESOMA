# AGESOMA control plane
DATABASE_URL=postgresql://USER:PASSWORD@HOST/agesoma?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=https://agesoma.example.com
AGESOMA_BRAIN_URL=http://brain:8080
AGESOMA_BRAIN_INTERNAL_API_TOKEN=replace-with-random-secret-at-least-32-chars
AGESOMA_BRAIN_SEARCH_TIMEOUT_MS=8000
AGESOMA_BRAIN_INGEST_TIMEOUT_MS=45000
AGESOMA_BRAIN_SEMAPHORE_LIMIT=4
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-random-password

# Provider-neutral Company Brain AI runtime.
# Recommended production topology: route this to an OpenAI-compatible gateway you control.
# The endpoint can front open-weight models through vLLM/Ollama/llama.cpp or external models.
AGESOMA_LLM_BASE_URL=
AGESOMA_LLM_API_KEY=
AGESOMA_LLM_MODEL=
AGESOMA_LLM_SMALL_MODEL=
AGESOMA_LLM_MAX_TOKENS=16384
AGESOMA_LLM_STRUCTURED_OUTPUT_MODE=json_schema
AGESOMA_EMBEDDING_BASE_URL=
AGESOMA_EMBEDDING_API_KEY=
AGESOMA_EMBEDDING_MODEL=
# Preserve Graphiti 0.29.3's current vector index dimension unless deliberately migrated.
AGESOMA_EMBEDDING_DIM=1024
AGESOMA_RERANK_MODEL=

# Compatibility fallbacks. These are optional when AGESOMA_LLM_* is set.
LITELLM_BASE_URL=
LITELLM_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Execution plane
HERMES_SERVICE_TOKEN=replace-with-random-secret-at-least-32-chars
CREDENTIAL_BROKER_SERVICE_TOKEN=replace-with-a-different-random-secret-at-least-32-chars
HERMES_RUN_TIMEOUT_MS=120000
HERMES_RUN_POLL_MS=1000
ANTHROPIC_API_KEY=
NOUS_API_KEY=
AGESOMA_MIN_NET_VALUE_CENTS=100
AGESOMA_MAX_TASK_COST_CENTS=500

# WhatsApp Business Cloud API (official Meta path)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_HOME_CHANNEL=

# Keep closed while configuring. For a public customer-support number, switch the policy
# only after a restricted Hermes toolset has been configured for whatsapp_cloud.
WHATSAPP_CLOUD_DM_POLICY=allowlist
WHATSAPP_CLOUD_ALLOWED_USERS=
WHATSAPP_CLOUD_ALLOW_FROM=
WHATSAPP_CLOUD_ALLOW_ALL_USERS=false

# Optional stable HTTPS ingress for Meta webhooks.
CLOUDFLARE_TUNNEL_TOKEN=
WHATSAPP_CLOUD_PUBLIC_HOSTNAME=

# OSS observability target. Keep optional until the services are deployed.
OTEL_EXPORTER_OTLP_ENDPOINT=
GLITCHTIP_DSN=
