{
  "name": "agesoma",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @agesoma/web",
    "build": "npm run build --workspace @agesoma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker": "npm run dev --workspace @agesoma/worker",
    "test": "tsx --test packages/core/test/*.test.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
