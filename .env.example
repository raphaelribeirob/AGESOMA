# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agesoma
AGESOMA_DB_SCHEMA=agesoma_p0
AGESOMA_INTERNAL_API_TOKEN=replace-with-at-least-32-random-bytes
OUTCOME_VERIFIER_TOKEN=replace-with-a-different-random-secret

# Controlled alpha owner workspace. The server-rendered home stays empty when unset.
# Replace this with authenticated tenant resolution before multi-tenant public launch.
INSTANTWORK_DEFAULT_TENANT_ID=

# Execution plane: Hermes runs as a separate isolated service/container.
# Do not expose Hermes directly to the public Internet.
HERMES_BASE_URL=http://localhost:8642
HERMES_SERVICE_TOKEN=replace-with-a-different-random-secret
HERMES_RUN_TIMEOUT_MS=120000
HERMES_RUN_POLL_MS=1000

# Official WhatsApp Business Cloud API through the Hermes gateway.
# Required for the adapter: PHONE_NUMBER_ID + ACCESS_TOKEN.
# Required for secure inbound webhooks: APP_SECRET + VERIFY_TOKEN.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_HOME_CHANNEL=
WHATSAPP_CLOUD_DM_POLICY=allowlist
WHATSAPP_CLOUD_ALLOWED_USERS=
WHATSAPP_CLOUD_ALLOW_FROM=
WHATSAPP_CLOUD_ALLOW_ALL_USERS=false
CLOUDFLARE_TUNNEL_TOKEN=
WHATSAPP_CLOUD_PUBLIC_HOSTNAME=

# Economic defaults (P0)
AGESOMA_MIN_NET_VALUE_CENTS=100
AGESOMA_MAX_TASK_COST_CENTS=500

# AI gateway (optional P0; keep provider credentials outside Hermes)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=replace-me

# Product / reliability observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
