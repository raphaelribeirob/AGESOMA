# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agesoma
AGESOMA_DB_SCHEMA=agesoma_p0
AGESOMA_INTERNAL_API_TOKEN=replace-with-at-least-32-random-bytes
OUTCOME_VERIFIER_TOKEN=replace-with-a-different-random-secret

# Controlled alpha owner workspace. The server-rendered home stays empty when unset.
# Replace this with authenticated tenant resolution before multi-tenant public launch.
AGESOMA_DEFAULT_TENANT_ID=
# Legacy compatibility only. Prefer AGESOMA_DEFAULT_TENANT_ID.
INSTANTWORK_DEFAULT_TENANT_ID=

# Company Brain: Graphiti + Neo4j. Internal only; never expose directly to the public Internet.
AGESOMA_BRAIN_URL=http://localhost:8081
AGESOMA_BRAIN_INTERNAL_API_TOKEN=replace-with-at-least-32-random-bytes
AGESOMA_BRAIN_SEARCH_TIMEOUT_MS=8000
AGESOMA_BRAIN_INGEST_TIMEOUT_MS=45000
AGESOMA_BRAIN_SEMAPHORE_LIMIT=4
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password

# Provider-neutral Company Brain AI runtime.
# Point AGESOMA_LLM_BASE_URL at any OpenAI-compatible OSS endpoint such as LiteLLM,
# vLLM, Ollama or llama.cpp. OPENAI_* remains only a compatibility fallback.
AGESOMA_LLM_BASE_URL=http://localhost:4000
AGESOMA_LLM_API_KEY=replace-with-local-or-gateway-key
AGESOMA_LLM_MODEL=
AGESOMA_LLM_SMALL_MODEL=
AGESOMA_LLM_MAX_TOKENS=16384
AGESOMA_LLM_STRUCTURED_OUTPUT_MODE=json_schema
AGESOMA_EMBEDDING_BASE_URL=http://localhost:4000
AGESOMA_EMBEDDING_API_KEY=replace-with-local-or-gateway-key
AGESOMA_EMBEDDING_MODEL=
# Preserve Graphiti 0.29.3's existing default index dimension unless intentionally migrated.
AGESOMA_EMBEDDING_DIM=1024
AGESOMA_RERANK_MODEL=

# Optional AI gateway compatibility. The Company Brain checks these after AGESOMA_LLM_*.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=replace-me
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Execution plane: Hermes runs as a separate isolated service/container.
# Do not expose Hermes directly to the public Internet.
HERMES_BASE_URL=http://localhost:8642
HERMES_SERVICE_TOKEN=replace-with-a-different-random-secret
HERMES_RUN_TIMEOUT_MS=120000
HERMES_RUN_POLL_MS=1000
ANTHROPIC_API_KEY=
NOUS_API_KEY=

# Official WhatsApp Business Cloud API through the Hermes gateway.
# Required for the adapter: PHONE_NUMBER_ID + ACCESS_TOKEN.
# Required for secure inbound webhooks: APP_SECRET + VERIFY_TOKEN.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_HOME_CHANNEL=
WHATSAPP_CLOUD_DM_POLICY=allowlist
WHATSAPP_CLOUD_ALLOWED_USERS=
WHATSAPP_CLOUD_ALLOW_FROM=
WHATSAPP_CLOUD_ALLOW_ALL_USERS=false
CLOUDFLARE_TUNNEL_TOKEN=
WHATSAPP_CLOUD_PUBLIC_HOSTNAME=

# Economic defaults (P0)
AGESOMA_MIN_NET_VALUE_CENTS=100
AGESOMA_MAX_TASK_COST_CENTS=500

# Product / reliability observability. PostHog can be self-hosted. Do not add a
# proprietary error-tracking dependency to the control plane; the OSS target is OTel + GlitchTip.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
GLITCHTIP_DSN=
