# AGESOMA WEB — Vercel new-account environment inventory (NO credentials in Git)
# Add values using Vercel Settings > Environment Variables, never in this file.
# Production and Preview should point at separately isolated Neon branches/databases.
#
# Required for core web + Better Auth
DATABASE_URL=
AGESOMA_DB_SCHEMA=agesoma_p0
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
#
# Required only when enabling internal orchestration or verified outcomes
AGESOMA_INTERNAL_API_TOKEN=
OUTCOME_VERIFIER_TOKEN=
#
# Optional; only configure once the self-hosted Graphiti service is protected
# and has a server-to-server HTTPS endpoint reachable from Vercel.
AGESOMA_BRAIN_URL=
AGESOMA_BRAIN_INTERNAL_API_TOKEN=
#
# Optional analytics / telemetry
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
GLITCHTIP_DSN=
#
# Worker, HERMES, pg-boss and Neo4j/Graphiti are NOT Vercel Functions.
# Never copy localhost URLs or Docker service names into production settings.
